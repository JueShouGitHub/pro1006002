<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:pro1006002"
             xmlns:components="clr-namespace:pro1006002.Components"
             x:Class="pro1006002.MainPage" NavigationPage.HasNavigationBar="False">
    <Grid>
    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

        <Grid IsVisible="{Binding IsLoading}" InputTransparent="False">
            <Image Source="bg.png" Aspect="AspectFill" />

            <Border StrokeThickness="1"
                    Stroke="#33FFFFFF"
                    BackgroundColor="#CC000000"
                    StrokeShape="RoundRectangle 24"
                    Padding="32"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <VerticalStackLayout Spacing="16">
                    <local:LoadingDots IsRunning="{Binding IsLoading}"
                                       DotColor="#FFFFFF"
                                       HorizontalOptions="Center" />
                    <Label Text="Loading"
                           TextColor="#E0E0E0"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
